              <mxPoint x="1150" y="1102" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Finish → Learners see result -->
        <mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_finish" target="n_result" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="1102" />
              <mxPoint x="131" y="1102" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Result → End -->
        <mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="n_result" target="end" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Also: expire → end (both get notified) -->
        <mxCell id="e30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_expire" target="n_ch_rejected" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
