          <mxGeometry x="455" y="480" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- Diamond: Role = Admin? -->
        <mxCell id="d_admin" value="Role = Admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#8B0000;strokeColor=#8B0000;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="560" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- requiresPlatformSetup = true -->
        <mxCell id="n_setup" value="requiresPlatform&#xa;Setup = true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="700" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- Return user info + token -->
        <mxCell id="n_return" value="Return user info + token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="800" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- ===== DATABASE NODES ===== -->
