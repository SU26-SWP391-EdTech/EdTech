          <mxGeometry x="450" y="355" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- Exception: not verified -->
        <mxCell id="n_exc_verify" value="Throw exception &quot;Please verify your email first&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
