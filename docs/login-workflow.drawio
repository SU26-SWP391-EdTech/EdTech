        <mxCell id="n_query" value="Query user by email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Check platform configured -->
        <mxCell id="d_platform" value="Platform configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#8B0000;strokeColor=#8B0000;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="550" width="140" height="80" as="geometry" />
