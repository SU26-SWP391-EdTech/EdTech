        <!-- ===== END CIRCLE ===== -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#CC0000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="121" y="905" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->
        <!-- Start → User choose Login -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#CC0000;strokeWidth=1.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="start" target="n_choose" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User choose Login → User input -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_choose" target="n_input" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User input → Validate data -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_input" target="n_validate" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validate data → Query user by email (to DB) -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_validate" target="n_query" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Query DB → Credentials correct? diamond -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_query" target="d_creds" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Credentials correct? → no → Throw exception invalid -->
        <mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_creds" target="n_exc_creds" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="270" />
              <mxPoint x="370" y="270" />
              <mxPoint x="370" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Throw exception invalid → back to User input (loop back) -->
        <mxCell id="e6b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_exc_creds" target="n_input" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
