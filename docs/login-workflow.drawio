        </mxCell>

        <!-- Return user info → Login completed (Learner) -->
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_return" target="n_loginsuccess" parent="1">
          <mxGeometry relative="1" as="geometry">
