              <mxPoint x="200" y="270" />
              <mxPoint x="133" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Credentials correct? → yes → Email verified? -->
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_creds" target="d_verified" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Email verified? → no → Throw exception not verified -->
        <mxCell id="e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_verified" target="n_exc_verify" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="395" />
              <mxPoint x="370" y="395" />
              <mxPoint x="370" y="485" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Email verified? → yes → Generate JWT -->
        <mxCell id="e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_verified" target="n_jwt" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Generate JWT → Role=Admin? -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_jwt" target="d_admin" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Role=Admin? → yes → Check platform configured (DB) -->
        <mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_admin" target="d_platform" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="600" />
              <mxPoint x="890" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Platform configured? → no → requiresPlatformSetup = true -->
        <mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_platform" target="n_setup" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="625" />
              <mxPoint x="700" y="625" />
              <mxPoint x="700" y="720" />
              <mxPoint x="585" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Platform configured? → yes → Return user info -->
        <mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_platform" target="n_return" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="590" />
              <mxPoint x="960" y="820" />
              <mxPoint x="585" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- requiresPlatformSetup → Return user info -->
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;" edge="1" source="n_setup" target="n_return" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Role=Admin? → no → Return user info -->
        <mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#CC0000;strokeWidth=1.5;fontColor=#CC0000;fontStyle=1;fontSize=10;" edge="1" source="d_admin" target="n_return" parent="1">
          <mxGeometry relative="1" as="geometry">
