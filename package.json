{
  "private": true,
  "scripts": {
    "preinstall": "node -e \"console.error('Stupid Thao, please use Docker. Do not run npm install locally in the root folder.'); process.exit(1)\"",
    "start": "docker-compose up -d",
    "start:build": "docker-compose up -d --build --remove-orphans",
    "start:database": "docker-compose up db phpmyadmin",
    "down": "docker-compose down",
    "down:remove-all": "docker-compose down -v",
    "restart": "docker-compose down && docker-compose up -d",
    "restart:build": "docker-compose down --remove-orphans && docker-compose up -d --build --remove-orphans",
    "logs": "docker-compose logs -f",
    "ps": "docker-compose ps",
    "rebuild": "docker-compose build --no-cache"
  }
}
